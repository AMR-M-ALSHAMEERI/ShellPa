# ShellPa normally creates a user-level configuration file through:
#   shellpa config
#
# ShellPa's interactive configuration stores API keys in the operating-system
# credential service. For explicitly project-managed configuration, a key may
# still be supplied here; ShellPa holds it in memory for provider requests and
# excludes it from executed child-command environments.

# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# SHELLPA_PROVIDER=openrouter
# SHELLPA_MODEL=openrouter/openai/gpt-4o-mini

# ChatGPT subscription access through the optional embedded Codex provider
# does not use an API key:
# SHELLPA_PROVIDER=codex
# SHELLPA_MODEL=codex/default

# Automatic recovery asks before using minimized, redacted failure facts.
# Provider-specific remembered choices are managed by ShellPa configuration.
# SHELLPA_RECOVERY_PERMISSION=ask

# ShellPa writes secret-free troubleshooting metadata locally by default.
# Set this to 0 to disable local event logging.
# SHELLPA_LOGGING=1
